{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": { "api/index.js": { "includeFiles": "web/**" } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }],
  "crons": [{ "path": "/api/cron/notify", "schedule": "0 6 * * *" }]
}
